{
  "schema_version": "phase7.ai_api_executor_config.v1",
  "executor_id": "executor_ai_api_exp1_baseline",
  "provider_family": "siliconflow",
  "selection_policy": {
    "kind": "uniform_random_without_weights",
    "seed_source": "request_or_environment_seed"
  },
  "defaults": {
    "timeout_seconds": 100,
    "max_tokens": 1024,
    "temperature": 0.0,
    "top_p": 1.0,
    "stream": false,
    "max_provider_attempts": 1
  },
  "entries": [
    {
      "entry_id": "glm_5_2_exp1_baseline",
      "enabled": true,
      "base_url": "https://api.siliconflow.cn/v1",
      "api_key_env": "TOKENSHARE_EXP1_BASELINE_API_KEY",
      "model": "zai-org/GLM-5.2",
      "endpoint": "/chat/completions",
      "supports_json_mode": true,
      "supports_streaming": false,
      "request_overrides": {
        "temperature": 0.0,
        "enable_thinking": false
      },
      "pricing": {
        "currency": "USD",
        "input_per_million_tokens": 1.0,
        "output_per_million_tokens": 2.0
      },
      "tags": [
        "paper",
        "exp1_baseline",
        "pilot"
      ]
    }
  ],
  "local_concurrency": {
    "max_in_flight_global": 10
  },
  "metadata": {
    "approval_snapshot": "exp1_minimal_pilot_v1",
    "pricing_note": "Conservative planning ceiling for Task 11 budget approval; actual provider usage and cost remain evidence-derived.",
    "secret_policy": "api_key_env_only"
  }
}
